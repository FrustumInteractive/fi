SOURCEDIR?=src
TOPDIR?=../..
INCDIR+=-I./include -I/usr/include -I./external -I$(TOPDIR)/include -I$(TOPDIR)/projects -I$(TOPDIR)/external
LIBDIR+=-L/usr/lib

# LunarG's Windows SDK uses capitalized Include/Lib directories.  Keep this in
# the shared template so Vulkan applications and all dependency builds see the
# same headers when FI_GFX_VULKAN is selected.
ifneq (,$(findstring FI_GFX_VULKAN,$(EXTRACXXFLAGS)))
ifneq ($(strip $(VULKAN_SDK)),)
VULKAN_SDK_PATH := $(subst \,/,$(VULKAN_SDK))
ifeq ($(OS),Windows_NT)
INCDIR += -I$(VULKAN_SDK_PATH)/Include
else
INCDIR += -I$(VULKAN_SDK_PATH)/include
endif
endif
endif

CXXFLAGS+=$(INCDIR) -Wall -std=c++17 $(EXTRACXXFLAGS)
OBJCFLAGS+=$(INCDIR) -fmodules
OBJCXXFLAGS+=$(INCDIR) -std=c++17 -fmodules $(EXTRACXXFLAGS)
LDFLAGS+=$(LIBDIR)
INFLAGS?=
DEFINES?=
ARCH?=
RELEASE_CXXFLAGS?=-O3

LIBS=$(LIBS_LINUX)

RESOURCES?=
CLEAN_EXTRA?=
BUILD_LOG_DIR?=.buildlogs
BUILD_LOG_FILE?=build.log
TARGET_BUILD_LOG:=$(BUILD_LOG_DIR)/$(TARGET).log
DEPENDENCY_MAKE_GOALS?=$(MAKECMDGOALS)

ifneq (,$(filter web gles3,$(MAKECMDGOALS)))
WEB=1
endif
ifneq (,$(filter gles3,$(MAKECMDGOALS)))
GLES3=1
endif

include $(TOPDIR)/templates/Makefile_include_toolchain

### Tool / OS specific substitutions
RM=rm -rf
CP=cp
MV=mv
SLASH=/
CMDSEP=;

### Operating system specific defines, etc.
ifdef WEB
	ifdef GLES3
		WEB_BUILD_VARIANT=web_gles3
		DEFINES +=-DWEB -D_GLES3 $(CXXFLAGS_WEB)
	else
		WEB_BUILD_VARIANT=web_gles2
		DEFINES +=-DWEB -D_GLES2 $(CXXFLAGS_WEB)
	endif
	C_FILES +=$(C_FILES_WEB)
	CXX_FILES +=$(CXX_FILES_WEB)
	DEPENDENCIES +=$(DEP_WEB)
	CXXFLAGS =$(INCDIR) -std=c++17 -sUSE_SDL=2 -O3 $(EXTRACXXFLAGS)
	LIBS=$(LIBS_WEB)
	ifdef GLES3
		LDFLAGS +=$(LIBDIR) -sWASM=1 -sUSE_SDL=2 -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 -O3 -sALLOW_MEMORY_GROWTH --emrun
	else
		LDFLAGS +=$(LIBDIR) -sWASM=1 -sUSE_SDL=2 -sMIN_WEBGL_VERSION=1 -sMAX_WEBGL_VERSION=1 -O3 -sALLOW_MEMORY_GROWTH --emrun
	endif
	CC =emcc
	CXX =em++
	OBJDIR=obj/$(WEB_BUILD_VARIANT)
else
	ifeq ($(OS),Windows_NT)
		DEFINES += -DWIN32 $(WINDOWS_VERSION_DEFINES) $(CXXFLAGS_WIN)
		ifeq ($(VSCMD_ARG_TGT_ARCH),x64)
			DEFINES += -DAMD64
		else ifeq ($(VSCMD_ARG_TGT_ARCH),x86)
			DEFINES += -DIA32
		else
		ifeq ($(PROCESSOR_ARCHITECTURE),AMD64)
			DEFINES += -DAMD64
		endif
		ifeq ($(PROCESSOR_ARCHITECTURE),x86)
			DEFINES += -DIA32
		endif
		endif

		LIBS=$(LIBS_W32)
		TARGET := $(if $(filter %.exe,$(TARGET)),$(TARGET),$(TARGET).exe)
		CLEAN_TARGET=$(TARGET)
		CLEAN_EXTRA += $(basename $(TARGET))
		C_FILES += $(C_FILES_WIN)
		CXX_FILES += $(CXX_FILES_WIN)
		INCDIR +=\
			-I$(TOPDIR)/extern/glew-1.13.0/include
		LIBDIR +=\
			-L$(TOPDIR)/extern/glew-1.13.0/lib/release/win32
		DEPTEMP := $(DEP_WIN32)
		DEPTEMP += $(DEPENDENCIES)
		DEPENDENCIES := $(DEPTEMP)
		
	ifndef BASH_EMU
		DEPENDENCIES := $(subst /,\\, $(DEPENDENCIES))
		RM=del /F /Q
		CP=copy
		SLASH=\\
		CMDSEP=&
	endif

	else
		UNAME_S := $(shell uname -s)
		UNAME_P := $(shell uname -m)

		ifeq ($(UNAME_S),Linux)
			DEFINES += -DLINUX
			C_FILES += $(C_FILES_LINUX)
			CXX_FILES += $(CXX_FILES_LINUX)
			LIBDIR+=\
				-L/usr/lib/x86-linux-gnu \
				-L/usr/lib/x86_64-linux-gnu
			DEPENDENCIES += $(DEP_LINUX)
		endif

		ifeq ($(UNAME_S),Darwin)
			LIBS=$(LIBS_OSX)
			DEFINES += -DOSX
			C_FILES += $(C_FILES_OSX)
			CXX_FILES += $(CXX_FILES_OSX)
			OBJC_FILES += $(OBJC_FILES_OSX)
			OBJCXX_FILES += $(OBJCXX_FILES_OSX)
			ifeq ($(ARCH),)
				ifeq ($(UNAME_P), x86_64)
					CXXFLAGS += -mmacosx-version-min=10.15 -arch x86_64
				endif
			else
				CXXFLAGS += -mmacosx-version-min=10.15 -arch arm64
				CCFLAGS += -mmacosx-version-min=10.15 -arch arm64
				OBJCFLAGS += -mmacosx-version-min=10.15 -arch arm64
				OBJCXXFLAGS += -mmacosx-version-min=10.15 -arch arm64
				LDFLAGS += -mmacosx-version-min=10.15 -arch arm64
			endif
			LIBDIR+=
			DEPENDENCIES += $(DEP_OSX)
			# include recipe text to make .app package
			include $(TOPDIR)/templates/Makefile_include_osx
		endif

		ifeq ($(UNAME_P),x86_64)
			DEFINES += -DAMD64
		endif
		ifneq ($(filter %86,$(UNAME_P)),)
			DEFINES += -DIA32
		endif
		ifneq ($(filter arm%,$(UNAME_P)),)
			DEFINES += -DARM
		endif
	endif ### windows
endif ### web

ifdef debug
	CXXFLAGS += -g
	DEFINES += -D_DEBUG
endif

### Set path for output object files
OBJDIR?=obj
OBJECTS=$(patsubst %, $(OBJDIR)/%, $(C_FILES:.c=.o))
OBJECTS+=$(patsubst %, $(OBJDIR)/%, $(CXX_FILES:.cpp=.o))
OBJECTS+=$(patsubst %, $(OBJDIR)/%, $(OBJC_FILES:.m=.o))
OBJECTS+=$(patsubst %, $(OBJDIR)/%, $(OBJCXX_FILES:.mm=.o))


### add include & lib path from dependencies
INCDIR+=$(patsubst %, -I%/include, $(DEPENDENCIES))
LIBDIR+=$(patsubst %, -L%/lib, $(DEPENDENCIES))

all: finish

.PHONY: web gles3
web gles3: finish
	@:

debug: CXXFLAGS += -g
debug: DEFINES += -D_DEBUG
debug: finish

debug2: CXXFLAGS += -g
debug2: DEFINES += -D_DEBUG
debug2: DEFINES += -D_DEBUG_2
debug2: finish

release: CXXFLAGS += $(RELEASE_CXXFLAGS)
release: OBJCFLAGS += $(RELEASE_CXXFLAGS)
release: OBJCXXFLAGS += $(RELEASE_CXXFLAGS)
release: finish

$(OBJDIR)/%.o: $(SOURCEDIR)/%.c | dependencies init
	@echo " Compile: $<"
	@mkdir -p $(dir $@)
	@echo " Compile: $<" >> $(TARGET_BUILD_LOG)
	@tmp_log=$$(mktemp -t fi_target_XXXXXX.log); \
	if $(CC) $(CXXFLAGS) $(DEFINES) -c -o $@ $< > $$tmp_log 2>&1; then \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
	else \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
		exit 1; \
	fi

$(OBJDIR)/%.o: $(SOURCEDIR)/%.cpp | dependencies init
	@echo " Compile: $<"
	@mkdir -p $(dir $@)
	@echo " Compile: $<" >> $(TARGET_BUILD_LOG)
	@tmp_log=$$(mktemp -t fi_target_XXXXXX.log); \
	if $(CXX) $(CXXFLAGS) $(DEFINES) -c -o $@ $< > $$tmp_log 2>&1; then \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
	else \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
		exit 1; \
	fi

$(OBJDIR)/%.o: $(SOURCEDIR)/%.m | dependencies init
	@echo " Compile: $<"
	@mkdir -p $(dir $@)
	@echo " Compile: $<" >> $(TARGET_BUILD_LOG)
	@tmp_log=$$(mktemp -t fi_target_XXXXXX.log); \
	if $(CXX) $(OBJCFLAGS) $(DEFINES) -c -o $@ $< > $$tmp_log 2>&1; then \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
	else \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
		exit 1; \
	fi

$(OBJDIR)/%.o: $(SOURCEDIR)/%.mm | dependencies init
	@echo " Compile: $<"
	@mkdir -p $(dir $@)
	@echo " Compile: $<" >> $(TARGET_BUILD_LOG)
	@tmp_log=$$(mktemp -t fi_target_XXXXXX.log); \
	if $(CXX) $(OBJCXXFLAGS) $(DEFINES) -c -o $@ $< > $$tmp_log 2>&1; then \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
	else \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
		exit 1; \
	fi

$(TARGET): $(OBJECTS) dependencies | init
	@echo ""
	@echo " Link:"
	@echo "" >> $(TARGET_BUILD_LOG)
	@echo " Link: $@" >> $(TARGET_BUILD_LOG)
	@echo " Command: $(CXX) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS)" >> $(TARGET_BUILD_LOG)
	@tmp_log=$$(mktemp -t fi_target_XXXXXX.log); \
	if $(CXX) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS) > $$tmp_log 2>&1; then \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
	else \
		cat $$tmp_log; \
		cat $$tmp_log >> $(TARGET_BUILD_LOG); \
		rm -f $$tmp_log; \
		exit 1; \
	fi

dependencies: $(DEPENDENCIES)
	@echo ""
	@echo " Building prerequesite project: $^"
	@mkdir -p $(BUILD_LOG_DIR)
	@set -e; \
	for x in $^; do \
		project_name=$$(basename $$x); \
		project_log="$(BUILD_LOG_DIR)/$$project_name.log"; \
		status_file="$${TMPDIR:-/tmp}/fi_make_status_$$$$"; \
		echo ""; \
		echo " ----- [$$project_name] begin -----"; \
		( "$(MAKE)" -C $$x $(DEPENDENCY_MAKE_GOALS) 2>&1; echo $$? > $$status_file ) | tee $$project_log; \
		status=$$(cat $$status_file); \
		rm -f $$status_file; \
		if [ $$status -ne 0 ]; then \
			exit $$status; \
		fi; \
		echo " ----- [$$project_name] end -----"; \
	done

init:
	@echo ""
	@echo "*************************************"
	@echo "	Building: $(TARGET)"
	@echo "*************************************"
	@echo " Compiler: $(CXX)"
	@if [ -n "$(TOOLCHAIN)" ]; then echo " Toolchain: $(TOOLCHAIN)"; fi
	@if [ -n "$(WINDOWS_MIN_VERSION)" ]; then echo " Windows API baseline: $(WINDOWS_MIN_VERSION)"; fi
	@echo " CXXFLAGS: $(CXXFLAGS)"
	@echo " DEFINES:  $(DEFINES)"
	@echo " Executing pre-build clean commands..."
	@$(POSTBUILDCLEAN)
	@mkdir -p $(BUILD_LOG_DIR)
	@rm -f $(TARGET_BUILD_LOG)
	@echo "*************************************" >> $(TARGET_BUILD_LOG)
	@echo " Building: $(TARGET)" >> $(TARGET_BUILD_LOG)
	@echo "*************************************" >> $(TARGET_BUILD_LOG)
	@echo " Compiler: $(CXX)" >> $(TARGET_BUILD_LOG)
	@if [ -n "$(TOOLCHAIN)" ]; then echo " Toolchain: $(TOOLCHAIN)" >> $(TARGET_BUILD_LOG); fi
	@if [ -n "$(WINDOWS_MIN_VERSION)" ]; then echo " Windows API baseline: $(WINDOWS_MIN_VERSION)" >> $(TARGET_BUILD_LOG); fi
	@echo " CXXFLAGS: $(CXXFLAGS)" >> $(TARGET_BUILD_LOG)
	@echo " DEFINES:  $(DEFINES)" >> $(TARGET_BUILD_LOG)
	
finish: $(TARGET)
	@echo ""
ifeq ($(WEB), 1)
	@echo " Moving binary and JavaScript file to web folder:"
	@mkdir -p web
	$(MV) $(TARGET) $(TARGET).wasm web$(SLASH)
	@if [ -f $(TARGET).data ]; then $(MV) $(TARGET).data web$(SLASH); fi
	@echo ""
endif
	@echo " Executing post build commands..."
	@$(POSTBUILD)
	@echo " Writing ordered build log: $(BUILD_LOG_FILE)"
	@set -e; \
	rm -f $(BUILD_LOG_FILE); \
	for x in $(DEPENDENCIES); do \
		project_name=$$(basename $$x); \
		project_log="$(BUILD_LOG_DIR)/$$project_name.log"; \
		if [ -f $$project_log ]; then \
			cat $$project_log >> $(BUILD_LOG_FILE); \
			echo "" >> $(BUILD_LOG_FILE); \
		fi; \
	done; \
	if [ -f $(TARGET_BUILD_LOG) ]; then \
		cat $(TARGET_BUILD_LOG) >> $(BUILD_LOG_FILE); \
		echo "" >> $(BUILD_LOG_FILE); \
	fi
	@echo ""
	@echo "*Build completed.*"
	@echo ""

.PHONY: clean

deepclean: clean
	@set -e; \
	for x in $(DEPENDENCIES); do \
		"$(MAKE)" -C $$x clean; \
	done

clean:
	$(RM) $(CLEAN_TARGET) $(CLEAN_EXTRA)
	$(RM) web$(SLASH)$(CLEAN_TARGET).worker.js
	$(RM) web$(SLASH)$(CLEAN_TARGET).wasm
	$(RM) web$(SLASH)$(CLEAN_TARGET).data
	$(RM) web$(SLASH)$(CLEAN_TARGET)
	$(RM) $(OBJDIR)
	$(RM) core.*
	$(RM) src$(SLASH)moc_*
	$(POSTBUILDCLEAN)
